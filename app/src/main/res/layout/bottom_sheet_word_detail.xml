<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    app:behavior_hideable="true"
    app:behavior_peekHeight="300dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <!-- 拖拽把手 -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@drawable/drag_handle_bg" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg">

            <!-- 单词 + 收藏/错词按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_phonetic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_subtitle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pronounce"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:contentDescription="发音"
                            app:icon="@android:drawable/ic_lock_silent_mode" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_favorite"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="收藏"
                    app:icon="@android:drawable/btn_star" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mistake"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:contentDescription="加入错词本"
                    app:icon="@color/md_theme_primary" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_md"
                android:background="?attr/colorOutline" />

            <!-- 中文释义 -->
            <TextView
                android:id="@+id/tv_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_subtitle" />

            <!-- 例句 -->
            <LinearLayout
                android:id="@+id/layout_example"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_detail_example"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    app:cardCornerRadius="@dimen/card_corner_radius_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            android:id="@+id/tv_example_sentence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/tv_example_translation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:lineSpacingExtra="2dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 词根词缀 -->
            <LinearLayout
                android:id="@+id/layout_root_affix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_detail_root_affix"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <!-- 词根词缀可视化容器：前缀(蓝)/词根(黑)/后缀(绿) -->
                <LinearLayout
                    android:id="@+id/layout_root_affix_visual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_xs" />

                <!-- 旧版纯文本（作为降级显示，代码优先使用可视化） -->
                <TextView
                    android:id="@+id/tv_root_affix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_body"
                    android:visibility="gone" />

                <!-- 词根词缀图例 -->
                <LinearLayout
                    android:id="@+id/layout_root_affix_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/md_theme_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="前缀"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/md_theme_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="词根"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/semantic_familiar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="后缀"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 近义词 / 反义词 -->
            <LinearLayout
                android:id="@+id/layout_syn_ant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_synonyms_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_detail_synonyms"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_synonyms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_antonyms_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/word_detail_antonyms"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_antonyms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 易混淆词对比 -->
            <LinearLayout
                android:id="@+id/layout_confusable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_detail_confusable"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    app:cardCornerRadius="@dimen/card_corner_radius_sm">

                    <LinearLayout
                        android:id="@+id/layout_confusable_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <!-- 由代码动态填充 -->

                        <TextView
                            android:id="@+id/tv_no_confusable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/word_detail_no_data"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 无数据提示 -->
            <TextView
                android:id="@+id/tv_no_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center"
                android:text="@string/word_detail_no_data"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 下一个单词按钮（学习页模式时显示） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next_word"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginVertical="@dimen/spacing_md"
        android:text="下一个"
        android:visibility="gone"
        app:backgroundTint="@color/md_theme_primary" />

</LinearLayout>
