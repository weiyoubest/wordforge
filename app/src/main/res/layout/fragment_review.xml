<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- ========== 列表模式 ========== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_list_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- 标题栏 -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/review_title"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

            <!-- 错词优先提示卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mistake_alert"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="gone"
                app:cardBackgroundColor="@color/semantic_unknown"
                app:cardCornerRadius="@dimen/card_corner_radius">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="错词提示"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="@color/md_theme_on_error" />

                    <TextView
                        android:id="@+id/tv_mistake_alert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:textColor="@color/md_theme_on_error"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mistake_review"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_mistake_btn"
                        android:textColor="@color/md_theme_on_error" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 复习时间线 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="复习时间线"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <!-- 时间线分组容器 -->
                <LinearLayout
                    android:id="@+id/layout_timeline_groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 无到期单词提示 -->
                    <TextView
                        android:id="@+id/tv_no_due_words"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="@dimen/spacing_lg"
                        android:text="暂无待复习单词"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- 开始全部复习按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_all_review"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/review_start_all" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ========== 卡片复习模式 ========== -->
    <LinearLayout
        android:id="@+id/layout_card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 顶部模式标签 + 返回 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_card_back"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="返回"
                app:icon="@drawable/ic_back" />

            <TextView
                android:id="@+id/tv_review_mode_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="复习模式"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />

        </LinearLayout>

        <!-- 进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/review_progress_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackThickness="@dimen/progress_bar_height" />

            <TextView
                android:id="@+id/tv_review_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <!-- 卡片翻转容器 -->
        <FrameLayout
            android:id="@+id/review_card_flip_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/spacing_md">

            <!-- 正面 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/review_card_front"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="@dimen/card_corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        android:id="@+id/tv_review_front_spelling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_word"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_review_front_phonetic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_phonetic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/learn_tap_to_show"
                        android:textColor="?attr/colorOutline"
                        android:textSize="@dimen/text_size_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 背面 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/review_card_back"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <!-- 单词 + 音标 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_review_back_spelling"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_review_back_phonetic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/text_size_caption" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_md"
                        android:background="?attr/colorOutline" />

                    <!-- 释义内容 -->
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_review_meaning"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="4dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_size_meaning" />

                            <!-- 例句 -->
                            <LinearLayout
                                android:id="@+id/layout_review_example"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/word_detail_example"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/text_size_caption"
                                    android:textStyle="bold" />

                                <com.google.android.material.card.MaterialCardView
                                    style="?attr/materialCardViewOutlinedStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    app:cardCornerRadius="@dimen/card_corner_radius_sm">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="@dimen/spacing_sm">

                                        <TextView
                                            android:id="@+id/tv_review_example_sentence"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:lineSpacingExtra="2dp"
                                            android:textColor="?attr/colorOnSurface"
                                            android:textSize="@dimen/text_size_body" />

                                        <TextView
                                            android:id="@+id/tv_review_example_translation"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/spacing_xs"
                                            android:lineSpacingExtra="2dp"
                                            android:textColor="?attr/colorOnSurfaceVariant"
                                            android:textSize="@dimen/text_size_caption" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.core.widget.NestedScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- 底部认知标记按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review_unknown"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/cognition_button_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/learn_unknown"
                app:backgroundTint="@color/semantic_unknown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review_vague"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/cognition_button_height"
                android:layout_marginHorizontal="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/learn_vague"
                app:backgroundTint="@color/semantic_vague" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review_familiar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/cognition_button_height"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/learn_familiar"
                app:backgroundTint="@color/semantic_familiar" />

        </LinearLayout>

    </LinearLayout>

    <!-- ========== 空状态 ========== -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/review_empty"
            android:src="@color/md_theme_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/review_empty"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/common_back" />

    </LinearLayout>

</FrameLayout>
